# The Cloudflare Tunnel: an outbound connection to Cloudflare, forwarding to Nginx on
# 127.0.0.1:8080. Install to /etc/systemd/system/. See docs/CLOUDFLARE_SETUP.md.
# Runs as its own user, which can read only /etc/cloudflared (config and tunnel credentials).
[Unit]
Description=Cloudflare Tunnel for Jifunze Kigiriama
After=network-online.target nginx.service
Wants=network-online.target
OnFailure=jifunze-failure@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
User=cloudflared
Group=cloudflared
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config.yml tunnel run
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# A tunnel client is small; this stops a leak from squeezing the app on a 2 GB Pi.
MemoryHigh=150M
MemoryMax=250M
TasksMax=128
LimitNOFILE=4096

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadOnlyPaths=/etc/cloudflared

[Install]
WantedBy=multi-user.target
