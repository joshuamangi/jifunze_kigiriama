# Template for /etc/jifunze/jifunze.env on the Pi (docs/PI_SETUP.md step 8). Mode 0640, owner
# root:jifunze. Never commit the real file. Plain KEY=value lines, no quotes and no spaces around
# "=": the same file is read by systemd and, by deploy.sh, by the shell.

APP_ENV=prod
# Python used to build each release's virtualenv (read by deploy.sh; the app ignores it).
JIFUNZE_PYTHON=/opt/python/cpython-3.11-linux-aarch64-gnu/bin/python3.11
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
COOKIE_SECURE=true
# The public address people use, so the Origin check lets their requests through.
ALLOWED_ORIGINS=https://CHANGE-ME.example.com

# Cloudflare Access second gate. When on, every request except /healthz must carry a valid
# Cf-Access-Jwt-Assertion token (signature, issuer, audience, expiry) or gets 403. Needs both values
# below, from the Zero Trust dashboard (team domain) and the Access application (audience tag).
# Leave off until Access is set up (docs/CLOUDFLARE_SETUP.md). Nginx serves web/ files itself.
CF_ACCESS_ENABLED=0
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# In-app invites (Settings > People). Leave all three empty to keep invites off; set all or none.
# The token needs only "Account, Access: Apps and Policies, Edit" (docs/CLOUDFLARE_SETUP.md).
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ACCESS_POLICY_ID=

APP_BASE_URL=https://CHANGE-ME.example.com
APP_TIMEZONE=Africa/Nairobi

DATABASE_PATH=/srv/jifunze/data/app.db
BACKUP_STAMP_PATH=/srv/jifunze/data/last_backup
BACKUP_DIR=/srv/jifunze/backups
# 1 when BACKUP_DIR is the SSD (bind-mounted): backups refuse to run if it is not mounted.
BACKUP_REQUIRE_MOUNT=1
BACKUP_KEEP=14
# Optional off-device copy, run with the new backup as "$1". Leave empty until you have one.
BACKUP_COPY_COMMAND=

# Start with "fake" (works without the model). Switch to onnx after the model is downloaded and
# make bench-embed has been run on the Pi.
EMBEDDER=fake
EMBED_MODEL=qint8
EMBED_MODEL_DIR=/srv/jifunze/models
EMBED_THREADS=2

# Argon2: tune on the Pi with scripts/bench_argon2.py, then set the values here.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Shortest password allowed when an account is created (6 to 128). Existing passwords are not
# re-checked. Keep 12 or more if the app is reachable from the internet.
PASSWORD_MIN_LENGTH=12

MAX_BODY_BYTES=65536
THREADPOOL_SIZE=12
SLOW_QUERY_MS=100

REMINDER_BACKEND=smtp
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
