# Sends the study reminders that are due. Run by jifunze-reminders.timer, never by the web app.
[Unit]
# Never start before /srv/jifunze is available. (Here it is on the SD card; if it is ever moved to
# an SSD partition this stops the app creating an empty database on the wrong disk.)
RequiresMountsFor=/srv/jifunze
Description=Jifunze Kigiriama study reminders
After=network-online.target
Wants=network-online.target
OnFailure=jifunze-failure@%n.service

[Service]
Type=oneshot
User=jifunze
Group=jifunze
WorkingDirectory=/srv/jifunze/current
EnvironmentFile=/etc/jifunze/jifunze.env
Environment=PYTHONPATH=/srv/jifunze/current
ExecStart=/srv/jifunze/current/.venv/bin/python scripts/send_reminders.py
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/jifunze/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallFilter=@system-service
