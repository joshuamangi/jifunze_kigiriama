# The web app: one Uvicorn worker on a Unix socket, behind Nginx.
# Install to /etc/systemd/system/. See docs/PI_SETUP.md.
[Unit]
# Never start without the SSD: a missing mount would otherwise create an empty database on the SD card.
RequiresMountsFor=/srv/jifunze
Description=Jifunze Kigiriama web app
After=network.target
OnFailure=jifunze-failure@%n.service
# Give up (and send the failure email) after 5 failed starts in 2 minutes instead of looping.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=jifunze
Group=jifunze
WorkingDirectory=/srv/jifunze/current
EnvironmentFile=/etc/jifunze/jifunze.env
# /run/jifunze is created for us, owned by jifunze, group-accessible so Nginx (in group
# jifunze) can reach the socket. UMask 0007 makes the socket srw-rw----.
RuntimeDirectory=jifunze
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/srv/jifunze/current/.venv/bin/uvicorn app.main:app \
    --uds /run/jifunze/app.sock --workers 1 \
    --limit-concurrency 64 --timeout-keep-alive 5 --timeout-graceful-shutdown 10 \
    --no-server-header --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=20

# Memory ceiling for a 4 GB Pi: the app plus the embedding model is well under this. If it is
# ever hit, systemd kills the app (and restarts it) instead of the whole machine swapping.
MemoryHigh=768M
MemoryMax=1G
TasksMax=64
LimitNOFILE=1024

# Sandbox. The app may write only to the data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/jifunze/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Deliberately NOT set: MemoryDenyWriteExecute (onnxruntime may need it) and ProcSubset=pid
# (onnxruntime reads /proc/cpuinfo). Re-check both on the Pi; see docs/PI_SETUP.md.

[Install]
WantedBy=multi-user.target
