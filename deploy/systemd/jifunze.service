# The web app: one Uvicorn worker on a Unix socket, behind Nginx.
# Install to /etc/systemd/system/. See docs/PI_SETUP.md.
[Unit]
# Never start before /srv/jifunze is available. (Here it is on the SD card; if it is ever moved to
# an SSD partition this stops the app creating an empty database on the wrong disk.)
RequiresMountsFor=/srv/jifunze
Description=Jifunze Kigiriama web app
After=network.target
OnFailure=jifunze-failure@%n.service
# Give up (and send the failure email) after 5 failed starts in 2 minutes instead of looping.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=jifunze
Group=jifunze
WorkingDirectory=/srv/jifunze/current
EnvironmentFile=/etc/jifunze/jifunze.env
# /run/jifunze is created for us, owned by jifunze, group-accessible so Nginx (in group
# jifunze) can reach the socket. UMask 0007 makes the socket srw-rw----.
RuntimeDirectory=jifunze
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/srv/jifunze/current/.venv/bin/uvicorn app.main:app \
    --uds /run/jifunze/app.sock --workers 1 \
    --limit-concurrency 64 --timeout-keep-alive 5 --timeout-graceful-shutdown 10 \
    --no-server-header --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=20

# Memory ceiling sized for a 2 GB Pi (about 1.8 GiB usable, shared with other services): the app
# plus the small quantised embedding model should stay well under this. If it is ever hit,
# systemd kills the app (and restarts it) instead of the whole machine swapping. Measure with
# `systemctl status jifunze` after a reindex and adjust.
MemoryHigh=450M
MemoryMax=600M
TasksMax=64
LimitNOFILE=1024

# Sandbox. The app may write only to the data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/jifunze/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Deliberately NOT set: MemoryDenyWriteExecute (onnxruntime may need it) and ProcSubset=pid
# (onnxruntime reads /proc/cpuinfo). Re-check both on the Pi; see docs/PI_SETUP.md.

[Install]
WantedBy=multi-user.target
