# Nightly database backup (deploy/backup.sh): checked copy, pruned, optional off-device copy.
[Unit]
# Never start before /srv/jifunze is available. (Here it is on the SD card; if it is ever moved to
# an SSD partition this stops the app creating an empty database on the wrong disk.)
RequiresMountsFor=/srv/jifunze /srv/jifunze/backups
Description=Jifunze Kigiriama database backup
OnFailure=jifunze-failure@%n.service

[Service]
Type=oneshot
User=jifunze
Group=jifunze
WorkingDirectory=/srv/jifunze/current
EnvironmentFile=/etc/jifunze/jifunze.env
Environment=JIFUNZE_BASE=/srv/jifunze
ExecStart=/srv/jifunze/current/deploy/backup.sh
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/jifunze/data /srv/jifunze/backups
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
