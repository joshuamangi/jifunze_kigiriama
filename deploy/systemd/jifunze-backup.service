# Nightly database backup (deploy/backup.sh): checked copy, pruned, optional off-device copy.
[Unit]
# Never start without the SSD: a missing mount would otherwise create an empty database on the SD card.
RequiresMountsFor=/srv/jifunze
Description=Jifunze Kigiriama database backup
OnFailure=jifunze-failure@%n.service

[Service]
Type=oneshot
User=jifunze
Group=jifunze
WorkingDirectory=/srv/jifunze/current
EnvironmentFile=/etc/jifunze/jifunze.env
Environment=JIFUNZE_BASE=/srv/jifunze
ExecStart=/srv/jifunze/current/deploy/backup.sh
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/jifunze/data /srv/jifunze/backups
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
