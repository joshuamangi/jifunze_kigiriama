# PRAGMA optimize refreshes the query planner's statistics; cheap, and best run now and then.
[Unit]
# Never start without the SSD: a missing mount would otherwise create an empty database on the SD card.
RequiresMountsFor=/srv/jifunze
Description=Jifunze Kigiriama SQLite PRAGMA optimize
OnFailure=jifunze-failure@%n.service

[Service]
Type=oneshot
User=jifunze
Group=jifunze
EnvironmentFile=/etc/jifunze/jifunze.env
ExecStart=/usr/bin/sqlite3 -cmd ".timeout 10000" ${DATABASE_PATH} "PRAGMA optimize;"
MemoryMax=128M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/jifunze/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
