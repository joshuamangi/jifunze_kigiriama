# Copy to .env for local use. Never commit .env. Values below are safe local defaults.

# dev or prod. In prod, SESSION_SECRET must be set and COOKIE_SECURE defaults to true.
APP_ENV=dev

# SQLite file. In production this lives on the USB SSD, not the microSD card.
DATABASE_PATH=data/app.db

# true/false. Defaults to false in dev and true in prod.
COOKIE_SECURE=false

# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=
