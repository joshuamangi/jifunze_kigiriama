# Copy to .env for local use. Never commit .env. Values below are safe local defaults.

# dev or prod. In prod, SESSION_SECRET must be set and COOKIE_SECURE defaults to true.
APP_ENV=dev

# SQLite file. In production this lives on the USB SSD, not the microSD card.
DATABASE_PATH=data/app.db

# true/false. Defaults to false in dev and true in prod.
COOKIE_SECURE=false

# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=

# Sessions: idle timeout and hard maximum age, in seconds (defaults: 7 days and 30 days).
SESSION_IDLE_SECONDS=604800
SESSION_MAX_AGE_SECONDS=2592000

# argon2id cost. Start at OWASP's minimum (19 MiB, 2 iterations, 1 lane); tune on the Pi with
# `make bench-argon2`.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Shortest password allowed when an account is created (6 to 128). Existing passwords are not
# re-checked. Keep 12 or more if the app is reachable from the internet.
PASSWORD_MIN_LENGTH=12

# Comma-separated allowed Origin values, e.g. https://jifunze.example.com. Empty = same host.
ALLOWED_ORIGINS=

# Cloudflare Access second gate. When on, every request except /healthz must carry a valid
# Cf-Access-Jwt-Assertion token (signature, issuer, audience, expiry) or gets 403. Needs both values
# below, from the Zero Trust dashboard (team domain) and the Access application (audience tag).
# Leave off until Access is set up (docs/CLOUDFLARE_SETUP.md). Nginx serves web/ files itself.
CF_ACCESS_ENABLED=0
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Search embeddings. "fake" is deterministic and needs no model (tests, quick local runs); "onnx"
# uses the real all-MiniLM-L6-v2 model after `make download-model`.
EMBEDDER=fake
# fp32 (~90 MB) or qint8 (~23 MB, built for arm64). Compare with `make bench-embed`.
EMBED_MODEL=fp32
EMBED_MODEL_DIR=models
# CPU threads for the model; keep low so a reindex does not starve the web process on a Pi.
EMBED_THREADS=2

# "Today" for due dates, the study streak and reminder send times. An IANA name, e.g. Africa/Nairobi.
APP_TIMEZONE=UTC
# A study session is at most this many cards (about 30 seconds each), with at most NEW_PER_DAY new.
SESSION_MAX_CARDS=40
NEW_PER_DAY=8

# Reminder emails (scripts/send_reminders.py). "console" prints them; "smtp" sends them.
REMINDER_BACKEND=console
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Hardening. Largest request body in bytes (real requests are a few KB).
MAX_BODY_BYTES=65536
# Threads for synchronous request handlers; 8 to 16, kept small for the Pi.
THREADPOOL_SIZE=12
# Database work slower than this many milliseconds is logged as a warning.
SLOW_QUERY_MS=100
# The backup job touches this file when it finishes; /api/admin/status shows its mtime.
BACKUP_STAMP_PATH=data/last_backup

# Failure alerts (scripts/notify_failure.py, run by systemd OnFailure=). Sent with the SMTP_*
# settings above. ALERT_BACKEND is "smtp" or "console"; it defaults to REMINDER_BACKEND.
ALERT_EMAIL=
ALERT_BACKEND=
