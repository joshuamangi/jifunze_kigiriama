# Managed by Ansible (infra/ansible/roles/jifunze_app). Edit group_vars/all.yml or the encrypted
# secrets file and run the playbook again; manual edits here are overwritten.
# Plain KEY=value lines, no quotes: systemd and deploy.sh both read this file.

APP_ENV=prod
JIFUNZE_PYTHON={{ python_bin }}
SESSION_SECRET={{ session_secret }}
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://{{ jifunze_hostname }}

CF_ACCESS_ENABLED={{ '1' if cf_access_enabled | bool else '0' }}
CF_ACCESS_TEAM_DOMAIN={{ cf_access_team_domain }}
CF_ACCESS_AUD={{ cf_access_aud }}

APP_BASE_URL=https://{{ jifunze_hostname }}
APP_TIMEZONE={{ app_timezone }}

DATABASE_PATH={{ base_dir }}/data/app.db
BACKUP_STAMP_PATH={{ base_dir }}/data/last_backup
BACKUP_DIR={{ base_dir }}/backups
BACKUP_REQUIRE_MOUNT=1
BACKUP_KEEP=14
BACKUP_COPY_COMMAND=

EMBEDDER={{ embedder }}
EMBED_MODEL={{ embed_model }}
EMBED_MODEL_DIR={{ base_dir }}/models
EMBED_THREADS=2

ARGON2_MEMORY_KIB={{ argon2_memory_kib }}
ARGON2_TIME_COST={{ argon2_time_cost }}
ARGON2_PARALLELISM={{ argon2_parallelism }}
PASSWORD_MIN_LENGTH={{ password_min_length }}

MAX_BODY_BYTES=65536
THREADPOOL_SIZE=12
SLOW_QUERY_MS=100

REMINDER_BACKEND=smtp
ALERT_EMAIL={{ alert_email }}
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USER={{ smtp_user }}
SMTP_PASSWORD={{ smtp_password }}
SMTP_FROM={{ smtp_from }}
SMTP_STARTTLS=true
